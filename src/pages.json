{
  "easycom": {
    "autoscan": false
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark",
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/category/category",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/product/detail",
      "style": {
        "navigationBarTitleText": "商品详情",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/cart/cart",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/user/profile",
      "style": {
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/order",
      "name": "order",
      "pages": [
        {
          "path": "create",
          "style": {
            "navigationBarTitleText": "确认订单"
          }
        },
        {
          "path": "list",
          "style": {
            "navigationBarTitleText": "我的订单",
            "enablePullDownRefresh": true
          }
        }
      ]
    },
    {
      "root": "pages/account",
      "name": "account",
      "pages": [
        {
          "path": "login",
          "style": {
            "navigationBarTitleText": "登录"
          }
        },
        {
          "path": "address",
          "style": {
            "navigationBarTitleText": "收货地址"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/cart/cart": {
      "network": "all",
      "packages": ["order"]
    },
    "pages/user/profile": {
      "network": "all",
      "packages": ["account"]
    }
  },
  "tabBar": {
    "color": "#909399",
    "selectedColor": "#fa436a",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-on.png"
      },
      {
        "pagePath": "pages/category/category",
        "text": "分类",
        "iconPath": "static/tabbar/cate.png",
        "selectedIconPath": "static/tabbar/cate-on.png"
      },
      {
        "pagePath": "pages/cart/cart",
        "text": "购物车",
        "iconPath": "static/tabbar/cart.png",
        "selectedIconPath": "static/tabbar/cart-on.png"
      },
      {
        "pagePath": "pages/user/profile",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-on.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "小蜂商城",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F7F7F7",
    "backgroundColorTop": "#F7F7F7",
    "backgroundColorBottom": "#F7F7F7"
  }
}
