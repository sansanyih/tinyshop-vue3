{
  "name": "tinyshop-vue3",
  "version": "3.0.0",
  "private": true,
  "description": "TinyShop 商城小程序重构版：uni-app + Vue3 + TypeScript + Vite + Pinia",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shots-all.mjs",
    "test:flow": "node scripts/flow-test.mjs",
    "check": "npm run lint && npm run type-check && npm run test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.77.8",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.2",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.0.29"
  }
}
